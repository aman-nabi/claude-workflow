{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/turn-start.sh"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/stop-gate.sh"],
            "timeout": 1800,
            "statusMessage": "tiered-workflow gate: lint, typecheck, related tests, comments"
          }
        ]
      }
    ]
  }
}
